# Web端（JS API）Key。不要在这里填写真实值后提交。
AMAP_JS_API_KEY=

# Web端 Key 对应的安全密钥。生产环境只由服务端代理读取。
AMAP_JS_SECURITY_CODE=

# 公开 branch 不携带 data/local；发布装配时从外部安全位置提供 reviewed marker source。
PUBLIC_AMAP_REVIEWED_SOURCE_FILE=
# 可选：server 使用的构建后最小 runtime layer 路径，默认写入 data/local/（gitignored）。
PUBLIC_AMAP_REVIEWED_FILE=

PUBLIC_AMAP_HOST=127.0.0.1
PUBLIC_AMAP_PORT=4173

# 非本机部署必须设置访问认证，并在 HTTPS 反向代理之后运行。
PRIVATE_MAP_USERNAME=
PRIVATE_MAP_PASSWORD=
PRIVATE_AMAP_HOST=127.0.0.1
PRIVATE_AMAP_PORT=8766
