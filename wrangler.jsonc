{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "china-imax-map",
  "account_id": "d3e9ae68daed415d2db68fbbaf484c7c",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist-public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/runtime-config.js",
      "/api/*",
      "/_AMapService/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "RUNTIME_BUCKET",
      "bucket_name": "china-imax-map-runtime"
    }
  ],
  "vars": {
    "MARKER_OBJECT_KEY": "public-amap-markers.json"
  },
  "secrets": {
    "required": ["AMAP_JS_API_KEY", "AMAP_JS_SECURITY_CODE"]
  },
  "observability": {
    "enabled": true
  }
}
